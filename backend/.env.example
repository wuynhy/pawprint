# Copy this file to .env (same folder) and paste your key after the =.
# .env is git-ignored, so the key never gets committed.
ANTHROPIC_API_KEY=

# Optional: email for password reset codes. Leave SMTP_HOST empty to print emails in the server
# terminal instead (fine for local testing and demos).
# Gmail example: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (no spaces) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
